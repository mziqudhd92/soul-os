                "$ref": "#/components/schemas/HybridCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete succeeded (sync reflect or reflect skipped)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "202": {
            "description": "Accepted \u2014 async reflect"
          },
          "404": {
            "description": "TURN_SESSION_EXPIRED \u2014 turn session missing or TTL-purged"
          },
          "409": {
            "description": "TURN_STATE_STALE \u2014 expected_version mismatch (CAS lost race)"
          },
          "422": {
            "description": "TURN_CONTRACT_VIOLATION | TURN_REJECT_TOKEN | TURN_STEP_MISMATCH | request validation"
          }
        }
      }
    },

{
  "name": "soulos-monorepo",
  "version": "0.5.0",
  "description": "SoulOS \u2014 open-source runtime for persistent AI avatars (HEXACO MSV, episodic memory, MCP, Soul Studio)",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mziqudhd92/soul-os.git"
  },
  "homepage": "https://mziqudhd92.github.io/soul-os/",
  "bugs": {
    "url": "https://github.com/mziqudhd92/soul-os/issues"
  },
  "keywords": [
    "soulos",
    "ai-agents",
    "mcp",
    "hexaco",
    "psychometrics",
    "fastapi",
    "pgvector",
    "chatbot",
    "episodic-memory",
    "cursor",
    "claude",
    "sse",
    "rag",
    "open-source"
  ],
  "workspaces": [
    "packages/soulos-sdk/ts"
  ],
  "scripts": {
    "test:all": "npm run test:kernel && npm run test:bridge && npm run test:gateway && npm run test:studio && npm run test:sdk && npm run test:turn-contracts",
    "test:kernel": "cd packages/soulos-core && ../../scripts/py.sh -m pytest -q -m 'not integration'",
    "test:turn-contracts": "cd packages/soulos-core && ../../scripts/py.sh ../../scripts/soulos-turn-contracts-eval.py",
    "test:bridge": "cd packages/soulos-inference-bridge && ../../scripts/py.sh -m pytest -q",
    "test:gateway": "cd packages/soulos-gateway && ../../scripts/py.sh -m pytest -q",
    "test:studio": "cd packages/soulos-studio && ../../scripts/py.sh -m pytest -q",
    "test:sdk": "cd packages/soulos-sdk/python && ../../../scripts/py.sh -m pytest -q && npm run test -w @soulos/sdk",
    "test:integration": "cd packages/soulos-core && SOULOS_INTEGRATION=1 ../../scripts/py.sh -m pytest -q -m integration",
    "test:coverage": "bash scripts/coverage.sh",
    "lint": "npm run lint:py && npm run typecheck",
    "lint:py": "scripts/py.sh -m ruff check packages scripts examples",
    "typecheck": "npm run typecheck -w @soulos/sdk",
    "setup": "bash scripts/setup-dev.sh",
    "clean": "bash scripts/clean.sh",
    "cloud:up": "docker compose -f docker-compose.cloud.yml up --build",
    "up": "docker compose up --build",
    "studio": "soulos-studio",
    "build:sdk": "npm run build -w @soulos/sdk",
    "seed": "python3 scripts/seed.py",
    "smoke:hybrid": "bash scripts/hybrid-smoke.sh",
    "demo": "bash scripts/demo-hybrid-cli.sh --simulate",
    "demo:record": "bash scripts/record-demo-gif.sh",
    "doc:gen": "python3 scripts/doc-gen/generate_docs.py",
    "doc:check": "python3 scripts/doc-gen/check_hybrid_docs.py && python3 scripts/doc-gen/check_doc_completeness.py && python3 scripts/doc-gen/check_version_sync.py && scripts/py.sh scripts/doc-gen/check_openapi_drift.py && python3 scripts/check-sdk-openapi-coverage.py",
    "version:sync": "python3 scripts/sync-version.py",
    "version:check": "python3 scripts/doc-gen/check_version_sync.py",
    "licenses:gen": "python3 scripts/generate-dependency-licenses.py",
    "licenses:check": "python3 scripts/generate-dependency-licenses.py --fail-on-copyleft --check",
    "openapi:export": "scripts/py.sh scripts/export-openapi.py",
    "build:site": "(test -x packages/soulos-studio/.venv/bin/python && packages/soulos-studio/.venv/bin/python || python3) scripts/build-studio-tutorials-site.py --out site --base /soul-os/",
    "build:tutorials-site": "npm run build:site"
  }
}
